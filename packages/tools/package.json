{
  "name": "@mirage/tools",
  "version": "1.0.0",
  "description": "Mirage tools: the playtest runner (scripted inputs, expectations, flicker along a path, frame cost, coded diagnostics with fixes, markdown report, contact sheet), a world check, single-file packager, multi-view snapshots, a frame-cost sweep, a static-deploy folder, the texture packer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraldaMeta/mirage-engine.git",
    "directory": "packages/tools"
  },
  "homepage": "https://github.com/paraldaMeta/mirage-engine/tree/main/packages/tools#readme",
  "bugs": {
    "url": "https://github.com/paraldaMeta/mirage-engine/issues"
  },
  "type": "module",
  "bin": {
    "mirage-validate-plan": "./src/validate-plan.mjs",
    "mirage-check": "./src/check-world.mjs",
    "mirage-playtest": "./src/playtest.mjs",
    "mirage-package": "./src/package.mjs",
    "mirage-walktest": "./src/walktest.mjs",
    "mirage-snap": "./src/snap.mjs",
    "mirage-perf": "./src/perf.mjs",
    "mirage-deploy": "./src/deploy.mjs",
    "mirage-e2e": "./src/e2e.mjs",
    "mirage-gpu-load": "./src/gpu-load.mjs",
    "mirage-still-pop": "./src/still-pop.mjs",
    "mirage-export": "./src/export.mjs"
  },
  "files": [
    "src",
    "tex",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@mirage/core": "^1.0.0",
    "@mirage/world": "^1.0.0",
    "puppeteer-core": "25.13.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node validate-plan.check.mjs && node diagnostics.check.mjs && node acceptance.check.mjs && node gpu-ci.check.mjs && node unit.mjs && node export.check.mjs"
  },
  "author": "灰叔 Racso",
  "devDependencies": {
    "gltf-validator": "2.0.0-dev.3.10"
  }
}
