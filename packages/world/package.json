{
  "name": "@miragekit/world",
  "version": "1.0.0",
  "description": "Mirage world protocol: the site plan (single source of positions), the module interface, the loader (order, failure isolation, anchors, ambient volumes) and seeded randomness per module.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraldaMeta/mirage-engine.git",
    "directory": "packages/world"
  },
  "homepage": "https://github.com/paraldaMeta/mirage-engine/tree/main/packages/world#readme",
  "bugs": {
    "url": "https://github.com/paraldaMeta/mirage-engine/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./plan.schema.json": "./plan.schema.json",
    "./kits/fur": {
      "types": "./src/kits/fur.d.ts",
      "default": "./src/kits/fur.js"
    },
    "./kits/rain": {
      "types": "./src/kits/rain.d.ts",
      "default": "./src/kits/rain.js"
    },
    "./kits/splat": {
      "types": "./src/kits/splat.d.ts",
      "default": "./src/kits/splat.js"
    },
    "./kits/terrain": {
      "types": "./src/kits/terrain.d.ts",
      "default": "./src/kits/terrain.js"
    },
    "./kits/vegetation": {
      "types": "./src/kits/vegetation.d.ts",
      "default": "./src/kits/vegetation.js"
    },
    "./kits/water": {
      "types": "./src/kits/water.d.ts",
      "default": "./src/kits/water.js"
    },
    "./loader": {
      "types": "./src/loader.d.ts",
      "default": "./src/loader.js"
    },
    "./partition": {
      "types": "./src/partition.d.ts",
      "default": "./src/partition.js"
    },
    "./plan": {
      "types": "./src/plan.d.ts",
      "default": "./src/plan.js"
    },
    "./plan-validation": {
      "types": "./src/plan-validation.d.ts",
      "default": "./src/plan-validation.js"
    },
    "./stream": {
      "types": "./src/stream.d.ts",
      "default": "./src/stream.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "plan.schema.json",
    "README.md",
    "NOTES.template.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "three": ">=0.186.1 <0.187.0",
    "@miragekit/core": "^1.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node check.mjs && node vegetation.check.mjs && node landscape.check.mjs && node splat.check.mjs"
  },
  "author": "灰叔 Racso"
}
