{
  "name": "@mirage/game",
  "version": "0.2.0",
  "description": "Mirage game layer: entities and systems, Rapier physics (lazy WASM) with a kinematic character controller and doors, an action-mapped input (keyboard, mouse, gamepad, touch), a Web Audio mixer with procedural sounds, interactables, inventory, flags, events, save/load, pause and an accessible HTML overlay.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": "./src/*.js",
    "./package.json": "./package.json"
  },
  "imports": {
    "#rapier": {
      "types": {
        "node": "./types/rapier/rapier.d.ts",
        "default": "@dimforge/rapier3d-compat"
      },
      "default": "@dimforge/rapier3d-compat"
    }
  },
  "files": [
    "types/rapier",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3"
  },
  "peerDependencies": {
    "three": "0.186.1",
    "@mirage/core": "0.2.0",
    "@mirage/world": "0.2.0",
    "@mirage/play": "0.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node check.mjs"
  },
  "author": "灰叔 Racso",
  "types": "./src/index.d.ts"
}
