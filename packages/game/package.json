{
  "name": "@mirage/game",
  "version": "1.0.0",
  "description": "Mirage game layer: entities and systems, Rapier physics (lazy WASM) with a kinematic character controller and doors, an action-mapped input (keyboard, mouse, gamepad, touch), a Web Audio mixer with procedural sounds, interactables, inventory, flags, events, save/load, pause and an accessible HTML overlay.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraldaMeta/mirage-engine.git",
    "directory": "packages/game"
  },
  "homepage": "https://github.com/paraldaMeta/mirage-engine/tree/main/packages/game#readme",
  "bugs": {
    "url": "https://github.com/paraldaMeta/mirage-engine/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./audio": { "types": "./src/audio.d.ts", "default": "./src/audio.js" },
    "./audio-debug": { "types": "./src/audio-debug.d.ts", "default": "./src/audio-debug.js" },
    "./audio-dsp": { "types": "./src/audio-dsp.d.ts", "default": "./src/audio-dsp.js" },
    "./audio-engine": { "types": "./src/audio-engine.d.ts", "default": "./src/audio-engine.js" },
    "./audio-mixer": { "types": "./src/audio-mixer.d.ts", "default": "./src/audio-mixer.js" },
    "./audio-music": { "types": "./src/audio-music.d.ts", "default": "./src/audio-music.js" },
    "./audio-occlusion": { "types": "./src/audio-occlusion.d.ts", "default": "./src/audio-occlusion.js" },
    "./game": { "types": "./src/game.d.ts", "default": "./src/game.js" },
    "./input": { "types": "./src/input.d.ts", "default": "./src/input.js" },
    "./physics": { "types": "./src/physics.d.ts", "default": "./src/physics.js" },
    "./platform": { "types": "./src/platform.d.ts", "default": "./src/platform.js" },
    "./simulation": { "types": "./src/simulation.d.ts", "default": "./src/simulation.js" },
    "./start": { "types": "./src/start.d.ts", "default": "./src/start.js" },
    "./ui": { "types": "./src/ui.d.ts", "default": "./src/ui.js" },
    "./ui-canvas": { "types": "./src/ui-canvas.d.ts", "default": "./src/ui-canvas.js" },
    "./ui-i18n": { "types": "./src/ui-i18n.d.ts", "default": "./src/ui-i18n.js" },
    "./ui-kit": { "types": "./src/ui-kit.d.ts", "default": "./src/ui-kit.js" },
    "./ui-locales": { "types": "./src/ui-locales.d.ts", "default": "./src/ui-locales.js" },
    "./ui-menu": { "types": "./src/ui-menu.d.ts", "default": "./src/ui-menu.js" },
    "./ui-nav": { "types": "./src/ui-nav.d.ts", "default": "./src/ui-nav.js" },
    "./ui-reactive": { "types": "./src/ui-reactive.d.ts", "default": "./src/ui-reactive.js" },
    "./ui-widgets": { "types": "./src/ui-widgets.d.ts", "default": "./src/ui-widgets.js" },
    "./ui-world": { "types": "./src/ui-world.d.ts", "default": "./src/ui-world.js" },
    "./package.json": "./package.json"
  },
  "imports": {
    "#rapier": {
      "types": {
        "node": "./types/rapier/rapier.d.ts",
        "default": "@dimforge/rapier3d-compat"
      },
      "default": "@dimforge/rapier3d-compat"
    }
  },
  "files": [
    "types/rapier",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3"
  },
  "peerDependencies": {
    "three": ">=0.186.1 <0.187.0",
    "@mirage/core": "^1.0.0",
    "@mirage/world": "^1.0.0",
    "@mirage/play": "^1.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node check.mjs && node audio-check.mjs && node ui.check.mjs && node platform.check.mjs && node physics.check.mjs"
  },
  "author": "灰叔 Racso",
  "types": "./src/index.d.ts"
}
