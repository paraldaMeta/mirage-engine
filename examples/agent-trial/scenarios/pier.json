{
  "title": "pier: deck, rails, pier head",
  "query": "mode=walk&ui=0&grain=0&modules=pier",
  "w": 1440, "h": 900,
  "steps": [
    { "name": "on-deck", "place": { "eye": [-6, 4.02, 0], "look": [-64, 4.02, 0], "mode": "walk" }, "ms": 400,
      "expect": { "onGround": "== true", "y": "~ 2.4 0.05", "errors": "== 0" } },
    { "name": "walk-the-pier", "walkTo": [[-6, 0], [-57, 0.3], [-60, 3.6]], "run": true,
      "expect": { "x": "< -59.5", "y": "~ 2.4 0.05" } },
    { "name": "plank-gaps-hold", "walkTo": [[-60, 1.0], [-57, 1.2], [-4, 1.2]], "run": true, "expect": { "x": "> -4.5", "y": "~ 2.4 0.05" } },
    { "name": "rail-south-blocks", "place": { "eye": [-30, 4.02, 0], "look": [-30, 4.02, 9], "mode": "walk" },
      "keys": ["KeyW"], "ms": 2500, "expect": { "z": "< 1.85", "y": "~ 2.4 0.05" } },
    { "name": "rail-north-blocks", "place": { "eye": [-21, 4.02, 0], "look": [-21, 4.02, -9], "mode": "walk" },
      "keys": ["KeyW"], "ms": 2500, "expect": { "z": "> -1.85", "y": "~ 2.4 0.05" } },
    { "name": "lamp-side-rail-blocks", "place": { "eye": [-20, 4.02, 0], "look": [-20, 4.02, 9], "mode": "walk" },
      "keys": ["KeyW"], "ms": 2500, "expect": { "z": "< 1.85", "y": "~ 2.4 0.05" } },
    { "name": "head-west-rail", "place": { "eye": [-66, 4.02, 4], "look": [-80, 4.02, 4], "mode": "walk" },
      "keys": ["KeyW"], "ms": 3000, "expect": { "x": "> -69.85", "y": "~ 2.4 0.05" } },
    { "name": "head-south-rail", "place": { "eye": [-67, 4.02, 3], "look": [-67, 4.02, 12], "mode": "walk" },
      "keys": ["KeyW"], "ms": 3000, "expect": { "z": "< 5.85", "y": "~ 2.4 0.05" } },
    { "name": "head-north-rail", "place": { "eye": [-60, 4.02, -3], "look": [-60, 4.02, -12], "mode": "walk" },
      "keys": ["KeyW"], "ms": 3000, "expect": { "z": "> -5.85", "y": "~ 2.4 0.05" } },
    { "name": "head-east-rail", "place": { "eye": [-60, 4.02, 4], "look": [-40, 4.02, 4], "mode": "walk" },
      "keys": ["KeyW"], "ms": 3000, "expect": { "x": "< -58.15", "y": "~ 2.4 0.05" } },
    { "name": "flicker-walk", "place": { "eye": [-4, 4.02, 0], "look": [-58, 4.02, 0], "mode": "walk" },
      "flicker": { "path": "pier" }, "expect": { "flicker": "< 8" } },
    { "name": "frame-cost", "place": { "eye": [-6, 4.02, 0], "look": [-58, 4.02, 0], "mode": "walk" },
      "keys": ["KeyW"], "perf": { "frames": 90 }, "expect": { "frameMs": "< 8" } },
    { "name": "view-on-the-pier", "place": { "eye": [-30, 4.02, 1.2], "look": [-64, 8, 0], "mode": "fly" }, "ms": 300 },
    { "name": "view-from-the-sea", "place": { "eye": [-44, 5, 26], "look": [-52, 3, 0], "mode": "fly" }, "ms": 300 },
    { "name": "view-under-deck", "place": { "eye": [-26, 1.2, 9], "look": [-34, 1.4, 0], "mode": "fly" }, "ms": 300 },
    { "name": "view-aerial", "place": { "eye": [24, 32, 44], "look": [-32, 0, 0], "mode": "fly" }, "ms": 300 },
    { "name": "view-head", "place": { "eye": [-52, 9, 14], "look": [-64, 2.4, 0], "mode": "fly" }, "ms": 300 }
  ]
}
