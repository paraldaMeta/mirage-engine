{
  "title": "shore: promenade, parapet, land wall, benches, entrance posts",
  "query": "mode=walk&ui=0&grain=0&modules=shore",
  "w": 1440, "h": 900,
  "steps": [
    { "name": "spawn", "ms": 400, "expect": { "onGround": "== true", "y": "~ 2.4 0.05", "errors": "== 0" } },
    { "name": "to-the-opening", "walkTo": [[2, 0], [-1.6, 0]], "tol": 0.2, "expect": { "x": "< -1.4", "y": "~ 2.4 0.05", "onGround": "== true" } },
    { "name": "parapet-blocks", "place": { "eye": [0, 4.02, 10], "look": [-10, 4.02, 10], "mode": "walk" },
      "keys": ["KeyW"], "ms": 2500, "expect": { "x": "> -1.65", "y": "~ 2.4 0.05" } },
    { "name": "parapet-no-jump", "place": { "eye": [0, 4.02, -14], "look": [-10, 4.02, -14], "mode": "walk" },
      "keys": ["KeyW", "Space"], "ms": 2500, "expect": { "x": "> -1.65", "y": "~ 2.4 0.05" } },
    { "name": "land-wall-blocks", "place": { "eye": [7, 4.02, -12], "look": [20, 4.02, -12], "mode": "walk" },
      "keys": ["KeyW", "Space"], "ms": 2500, "expect": { "x": "< 9.95", "y": "~ 2.4 0.6" } },
    { "name": "bench-no-climb-out", "place": { "eye": [7, 4.02, -8], "look": [20, 4.02, -8], "mode": "walk" },
      "keys": ["KeyW", "Space"], "ms": 3000, "expect": { "x": "< 9.95", "y": "< 3.4", "onGround": "== true" } },
    { "name": "lamp-post-blocks", "place": { "eye": [-1.0, 4.02, 7], "look": [-1.0, 4.02, 0], "mode": "walk" },
      "keys": ["KeyW"], "ms": 2500, "expect": { "z": "> 3.1", "y": "~ 2.4 0.05" } },
    { "name": "walk-the-promenade", "place": { "eye": [4, 4.02, -26], "look": [4, 4.02, 0], "mode": "walk" },
      "walkTo": [[4, 0], [4, 26]], "run": true, "expect": { "z": "> 25", "y": "~ 2.4 0.05" } },
    { "name": "south-end", "keys": ["KeyW"], "ms": 2000, "expect": { "z": "< 30.2", "y": "~ 2.4 0.05" } },
    { "name": "north-end", "place": { "eye": [4, 4.02, -26], "look": [4, 4.02, -40], "mode": "walk" },
      "keys": ["KeyW"], "ms": 2000, "expect": { "z": "> -30.2", "y": "~ 2.4 0.05" } },
    { "name": "flicker-promenade", "place": { "eye": [6, 4.02, 8], "look": [-64, 4.02, 0], "mode": "walk" },
      "flicker": { "path": [[6, 8], [0, 0], [3, -20], [6, -24]] }, "expect": { "flicker": "< 8" } },
    { "name": "frame-cost", "place": { "eye": [6, 4.02, 8], "look": [-64, 4.02, 0], "mode": "walk" },
      "keys": ["KeyW"], "perf": { "frames": 90 }, "expect": { "frameMs": "< 8" } },
    { "name": "shot-promenade", "place": { "eye": [6, 4.02, 8], "look": [-64, 9, 0], "mode": "fly" }, "ms": 600 },
    { "name": "shot-entrance", "place": { "eye": [3, 4.02, -5], "look": [-2, 3.2, 1], "mode": "fly" }, "ms": 600 },
    { "name": "shot-benches", "place": { "eye": [2, 4.0, -3], "look": [9.4, 2.8, -14], "mode": "fly" }, "ms": 600 },
    { "name": "shot-looking-back", "place": { "eye": [-60, 4.02, -3.5], "look": [6, 3, 0], "mode": "fly" }, "ms": 600 },
    { "name": "shot-from-the-sea", "place": { "eye": [-44, 5, 26], "look": [-2, 3, 0], "mode": "fly" }, "ms": 600 },
    { "name": "shot-aerial", "place": { "eye": [24, 32, 44], "look": [-32, 0, 0], "mode": "fly" }, "ms": 600 }
  ]
}
