{
  "name": "garden-quest",
  "private": true,
  "version": "0.1.0",
  "description": "Mirage example: a small game in the walled garden — find the key, open the pavilion, light the lanterns. Physics, a character controller, gamepad and touch, procedural sound, save / load.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5184 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 5185 --strictPort",
    "playthrough": "node scripts/playthrough.mjs dist",
    "playtest": "node ../../packages/tools/src/playtest.mjs scenarios/playtest.json dist --out out/playtest",
    "package": "node ../../packages/tools/src/package.mjs ."
  },
  "dependencies": {
    "@mirage/core": "0.1.0",
    "@mirage/game": "0.1.0",
    "@mirage/play": "0.1.0",
    "@mirage/world": "0.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "puppeteer-core": "25.13.0",
    "vite": "8.3.4"
  }
}
