{
  "title": "snow-hut: the whole world (yard, fence, door, the stove)",
  "query": "start=1&grain=0",
  "w": 1440, "h": 900,
  "steps": [
    { "name": "spawn", "ms": 500, "expect": { "onGround": "== true", "y": "~ 0 0.3", "paused": "== false", "errors": "== 0" } },
    { "name": "to-the-door", "walkTo": [[1.3, 1.5], [1.3, 0.4]], "run": true, "expect": { "x": "~ 1.3 0.4", "z": "~ 0.4 0.4" } },
    { "name": "through-the-door", "walkTo": [[1.3, -1.6], [-1.2, -2.0], [-1.5, -3.9]], "expect": { "x": "~ -1.5 0.4", "z": "~ -3.9 0.4", "y": "~ 0.34 0.05" } },
    { "name": "stove-prompt", "lookAt": "stove", "expect": { "near": "== stove", "prompt": "has Light the stove" } },
    { "name": "light-the-stove", "tap": "KeyE", "ms": 800, "expect": { "flags.lit": "== true", "flags.done": "== true" } },
    { "name": "close-the-message", "tap": "Enter", "ms": 300, "expect": { "paused": "== false", "flags.lit": "== true" } },
    { "name": "wall-blocks", "place": { "eye": [-1, 1.96, -2], "look": [-10, 1.96, -2], "mode": "walk" }, "keys": ["KeyW"], "ms": 2000, "expect": { "x": "> -2.75", "y": "~ 0.34 0.05" } },
    { "name": "hut-blocks-from-outside", "place": { "eye": [-1, 1.62, 3], "look": [-1, 1.62, -10], "mode": "walk" }, "keys": ["KeyW"], "ms": 2500, "expect": { "z": "> -0.5" } },
    { "name": "fence-blocks-with-a-jump", "place": { "eye": [0, 1.62, 11], "look": [0, 1.62, 20], "mode": "walk" }, "tap": "Space", "keys": ["KeyW"], "ms": 3000, "expect": { "z": "< 14", "onGround": "== true" } },
    { "name": "fence-blocks-north", "place": { "eye": [-8, 1.62, -8], "look": [-8, 1.62, -20], "mode": "walk" }, "keys": ["KeyW"], "ms": 3000, "expect": { "z": "> -12" } },
    { "name": "flicker-on-the-route", "flicker": { "path": "route", "y": 0, "speed": 1.6 }, "expect": { "flicker": "< 10" } },
    { "name": "frame-cost", "place": { "eye": [4, 1.62, 11], "look": [0, 1.62, -3], "mode": "walk" }, "keys": ["KeyW"], "perf": { "frames": 90 }, "expect": { "frameMs": "< 8", "triangles": "< 600000" } },
    { "name": "view-arrival", "viewpoint": 0 },
    { "name": "view-porch", "viewpoint": 1 },
    { "name": "view-through-the-door", "viewpoint": 2 },
    { "name": "view-stove", "viewpoint": 3 },
    { "name": "view-up-the-slope", "viewpoint": 4 },
    { "name": "view-from-the-pines", "viewpoint": 5 },
    { "name": "view-aerial", "viewpoint": 6, "expect": { "errors": "== 0" } }
  ]
}
